{
  "name": "sealed-mail",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted webmail MVP. The server stores only ciphertext; message bodies and private keys never reach it in readable form.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "mail:test": "node scripts/send-test-mail.mjs",
    "setup:sendgrid": "node scripts/setup-sendgrid.mjs",
    "test": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mailparser": "3.9.41",
    "nodemailer": "10.1.3",
    "smtp-server": "3.19.24"
  }
}
