# Copy this file to .env and set a unique secret.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_chars
PORT=3000
NODE_ENV=development
# WebAuthn identity. Passkeys only work on this exact host/origin.
# Production example: RP_ID=mail.example.com  ORIGIN=https://mail.example.com
RP_ID=localhost
ORIGIN=http://localhost:3000

# --- Email ---
# Accounts are addresses on this domain (nombre@sealed.local).
MAIL_DOMAIN=sealed.local
# Mail from outside is received here (other mail servers / any mail client).
SMTP_IN_PORT=2525

# Outgoing mail to addresses outside Sealed Mail.
# Local testing: Mailpit catches everything (run `mailpit`, view http://localhost:8025).
SMTP_OUT_HOST=127.0.0.1
SMTP_OUT_PORT=1025

# To really deliver to anyone (Gmail, Outlook…) through your own Gmail account, run
# `npm run setup:gmail`: it checks an app password with Google and writes these lines
# (SMTP_OUT_HOST=smtp.gmail.com, port 587, user and SMTP_OUT_FROM = your address).
#
# Or with SendGrid, replace the two lines above with these and fill in YOUR values
# (never commit this file), or run `npm run setup:sendgrid`:
#   SMTP_OUT_HOST=smtp.sendgrid.net
#   SMTP_OUT_PORT=587
#   SMTP_OUT_USER=apikey
#   SMTP_OUT_PASS=<your SendGrid API key with "Mail Send" permission>
#   SMTP_OUT_FROM=<the sender address you verified in SendGrid>
#
# Or, with your own domain verified in Resend (send AND receive, recommended):
#   MAIL_DOMAIN=<a subdomain you own, e.g. mail.example.com, verified in Resend>
#   SMTP_OUT_HOST=smtp.resend.com
#   SMTP_OUT_PORT=587
#   SMTP_OUT_USER=resend
#   SMTP_OUT_PASS=<Resend key with sending access, restricted to that domain>
#   RESEND_RECEIVE_KEY=<Resend full-access key: needed to read received mail>
# (leave SMTP_OUT_FROM empty: each user sends from their own address)

# Reverse-proxy hops in front of the app in production (default 1). Set to the real
# count so X-Forwarded-For cannot be spoofed to evade the per-IP rate limits.
# TRUST_PROXY_HOPS=1
