# Copy this file to .env and set a unique secret.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_chars
PORT=3000
NODE_ENV=development
# WebAuthn identity. Passkeys only work on this exact host/origin.
# Production example: RP_ID=mail.example.com  ORIGIN=https://mail.example.com
RP_ID=localhost
ORIGIN=http://localhost:3000
